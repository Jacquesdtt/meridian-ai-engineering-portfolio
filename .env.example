# Note: Pydantic-Settings maps these into src/core/config.py.
#
# Live Azure drafts / RAG require at least an endpoint (azure_configured = endpoint set).
# Accepted aliases (either name works):
#   AZURE_OPENAI_ENDPOINT  or  AZURE_OPENAI_BASE_URL
#   AZURE_OPENAI_DEPLOYMENT or  AZURE_OPENAI_DEPLOYMENT_NAME
#   AZURE_OPENAI_API_KEY   or  AZURE_OPENAI_API_KEY_1  (portal KEY 1)
#   AZURE_OPENAI_API_KEY_2                              (portal KEY 2 — tried on 401)
#
# Prefer the Foundry host from portal Keys & Endpoint (Foundry tab), e.g.:
#   https://<resource>.services.ai.azure.com/openai/v1
# Endpoint may be the resource root OR already include /openai/v1.
# Optional: API key (prefer Azure CLI / Managed Identity in cloud), API version.

AZURE_OPENAI_ENDPOINT=https://your-company.services.ai.azure.com/
# AZURE_OPENAI_BASE_URL=https://your-company.services.ai.azure.com/openai/v1
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY_2=
# Set this to the name of the chat deployment configured in your Foundry resource.
# The verified Meridian environment uses gpt-5-mini.
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
# AZURE_OPENAI_API_VERSION=2024-10-21
ENVIRONMENT=development

# Friction-Gate UI -> API transport (ADR 006 follow-on). "http" needs uvicorn running;
# "inprocess" drives the same FastAPI app without a socket (AppLocker demo machines).
FRICTION_GATE_MODE=http
FRICTION_GATE_API_URL=http://127.0.0.1:8000
