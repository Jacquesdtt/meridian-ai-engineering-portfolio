{
  "name": "meridian-educational-tour",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:portal": "vite --port=3005 --strictPort --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "viva:benchmark": "uv run --directory .. python scripts/evaluate_viva_benchmark.py",
    "facts:export": "uv run --directory .. python educational_web_app/scripts/export_teaching_data.py",
    "facts:check": "uv run --directory .. python educational_web_app/scripts/export_teaching_data.py && git diff --exit-code -- src/content/generated public/assets"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "vite": "^6.4.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vitest": "^5.0.5"
  }
}
